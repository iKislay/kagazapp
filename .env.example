# ============================================================
# Kagaz backend environment — Appendix A of IMPLEMENTATION_PLAN.md
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ---- Core ----
NODE_ENV=development
PORT=8080
APP_VERSION=0.1.0-dev              # injected at build from the git tag
GIT_COMMIT=local                   # injected at build

# ---- Database ----
DATABASE_URL=postgresql://kagaz:kagaz@localhost:5432/kagaz?schema=public
DIRECT_DATABASE_URL=postgresql://kagaz:kagaz@localhost:5432/kagaz?schema=public

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=fake-access-key-id
R2_SECRET_ACCESS_KEY=fake-secret-access-key
R2_BUCKET=kagaz-files
R2_PUBLIC_BASE=                    # optional CDN base; bucket itself stays private

# ---- WhatsApp Cloud API ----
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=fake-permanent-system-user-token
WHATSAPP_VERIFY_TOKEN=pick-your-own-random-string
WHATSAPP_APP_SECRET=fake-app-secret
WHATSAPP_API_VERSION=v21.0

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_0000000000
RAZORPAY_KEY_SECRET=fake-key-secret
RAZORPAY_WEBHOOK_SECRET=fake-webhook-secret
RAZORPAY_ROUTE_ENABLED=true

# ---- Auth ----
DEVICE_JWT_SECRET=change-me-to-32-or-more-random-bytes-abcdef
DEVICE_JWT_TTL_DAYS=90
ADMIN_SESSION_SECRET=change-me-to-32-or-more-random-bytes-ghijkl
ADMIN_MAGIC_LINK_TTL_MIN=15
ADMIN_ALLOWED_EMAILS=you@example.com

# ---- Email (magic links, alerts) ----
SMTP_URL=smtp://user:pass@smtp.example.com:587
ALERT_EMAIL=alerts@example.com

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=info

# ---- Tunables ----
QUOTE_TTL_MINUTES=15
PAYMENT_LINK_TTL_MINUTES=15
PREFLIGHT_TIMEOUT_MS=5000
DISPATCH_ACK_TIMEOUT_MS=60000
PRINT_VERIFY_TIMEOUT_MS=120000
HEARTBEAT_INTERVAL_MS=15000
OFFLINE_THRESHOLD_MS=30000
FILE_RETENTION_HOURS=24
MAX_UPLOAD_BYTES=52428800
CONVERSION_TIMEOUT_MS=60000
STUCK_ORDER_THRESHOLD_MINUTES=120
